# Build output
/target
**/target

# Tauri build schemas, regenerated by tauri-build on every compile.
/src-tauri/gen/schemas

# src-tauri/icons/ is deliberately NOT ignored. tauri.conf.json references
# those files and `tauri::generate_context!` panics without them, so a fresh
# clone cannot build unless they are committed. icon.svg at the repo root is
# the source of truth; regenerate the set after editing it.

# Editors
.idea/
.vscode/
*.swp
.DS_Store
